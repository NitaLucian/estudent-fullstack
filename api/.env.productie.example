# Model pentru api/.env.productie.local: variabilele containerului la repetiția locală a
# producției (docker run --env-file). host.docker.internal = calculatorul gazdă, văzut din container.
DATABASE_URL="postgresql://estudent:estudent_dev@host.docker.internal:5433/estudent_productie?schema=public"
JWT_SECRET="inlocuiti-cu-un-sir-aleator-de-cel-putin-32-de-caractere"
COOKIE_SECURE=true
TRUST_PROXY=1              # un singur proxy local: wrangler
APP_URL="http://localhost:8788"
S3_ENDPOINT="http://host.docker.internal:8333"
S3_BUCKET="estudent-productie"
S3_ACCESS_KEY="estudent"
S3_SECRET_KEY="estudent_dev_secret"
EMAIL_FURNIZOR="smtp"
SMTP_HOST="host.docker.internal"
SMTP_PORT=1025
