// Modelul de date al aplicației eStudent.
// Din acest fișier Prisma generează: (1) migrările SQL, (2) clientul TypeScript.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// O specializare (program de studii), de exemplu „Calculatoare”.
model Specializare {
  id       Int     @id @default(autoincrement())
  cod      String  @unique @db.VarChar(15)
  denumire String  @db.VarChar(100)
  grupe    Grupa[] // relația 1–N: o specializare are mai multe grupe

  @@map("specializari") // numele tabelului în PostgreSQL
}

// O grupă de studenți, dintr-un an de studiu al unei specializări.
model Grupa {
  id             Int          @id @default(autoincrement())
  cod            String       @unique @db.VarChar(15)
  an             Int          @db.SmallInt // anul de studiu: 1–4
  specializareId Int          @map("specializare_id")
  specializare   Specializare @relation(fields: [specializareId], references: [id], onDelete: Restrict)
  studenti       Student[]

  @@index([specializareId])
  @@map("grupe")
}

// Un student. Deocamdată este legat direct de o grupă (opțional).
model Student {
  id           Int       @id @default(autoincrement())
  nrMatricol   String    @unique @map("nr_matricol") @db.VarChar(12)
  nume         String    @db.VarChar(50)
  prenume      String    @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  dataNasterii DateTime? @map("data_nasterii") @db.Date
  grupaId      Int?      @map("grupa_id")
  grupa        Grupa?    @relation(fields: [grupaId], references: [id], onDelete: Restrict)

  @@index([grupaId])
  @@index([nume, prenume])
  @@map("studenti")
}
