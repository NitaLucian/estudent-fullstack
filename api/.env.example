# Model pentru fișierul .env. Copiați-l: cp .env.example .env
DATABASE_URL="postgresql://estudent:estudent_dev@localhost:5433/estudent?schema=public"
PORT=3000

# Autentificare
JWT_SECRET="inlocuiti-cu-un-sir-aleator-de-cel-putin-32-de-caractere"
JWT_EXPIRA="15m"           # cât trăiește un token de acces
REFRESH_ZILE=7             # cât trăiește o sesiune (refresh token)
COOKIE_SECURE=false        # true în producție (cookie trimis doar prin HTTPS)
